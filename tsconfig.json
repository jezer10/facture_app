{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "@app/contracts": ["libs/contracts/src"],
      "@app/contracts/*": ["libs/contracts/src/*"],
      "@app/fiscal-domain": ["libs/fiscal-domain/src"],
      "@app/fiscal-domain/*": ["libs/fiscal-domain/src/*"],
      "@app/fiscal-core": ["libs/fiscal-core/src"],
      "@app/fiscal-core/*": ["libs/fiscal-core/src/*"],
      "@app/platform": ["libs/platform/src"],
      "@app/platform/*": ["libs/platform/src/*"],
      "@app/sunat": ["libs/sunat/src"],
      "@app/sunat/*": ["libs/sunat/src/*"],
      "@app/webhooks": ["libs/webhooks/src"],
      "@app/webhooks/*": ["libs/webhooks/src/*"]
    }
  },
  "include": ["apps/**/*.ts", "libs/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
