NODE_ENV=development
BILLING_SERVICE=billing-api
BILLING_PUBLIC_URL=http://localhost:3000
BILLING_TRUSTED_PROXY_CIDRS=172.30.250.1/32
BILLING_EGRESS_SUBNET=172.30.250.0/24
BILLING_EGRESS_GATEWAY=172.30.250.1
BILLING_API_PORT=3000
BILLING_WORKER_PORT=3001
SUNAT_SERVICE_PORT=3002
SUNAT_SERVICE_HOST=127.0.0.1
WEBHOOK_SERVICE_PORT=3003
SUNAT_INTERNAL_URL=http://localhost:3002
WEBHOOK_INTERNAL_URL=http://localhost:3003
INTERNAL_SERVICE_TIMEOUT_MS=5000

CORE_DATABASE_URL=postgresql://billing_core@localhost:5432/billing_core
SUNAT_DATABASE_URL=postgresql://billing_sunat@localhost:5432/billing_sunat
WEBHOOK_DATABASE_URL=postgresql://billing_delivery@localhost:5432/billing_delivery
CORE_DATABASE_PASSWORD_FILE=/run/secrets/core_db_password
SUNAT_DATABASE_PASSWORD_FILE=/run/secrets/sunat_db_password
WEBHOOK_DATABASE_PASSWORD_FILE=/run/secrets/webhook_db_password

# Usa billing_worker, billing_sunat o billing_webhook y su secreto correspondiente.
REDIS_URL=redis://billing_worker@localhost:6379/0
REDIS_PASSWORD_FILE=/run/secrets/redis_worker_password

BILLING_JWT_SECRET_FILE=/run/secrets/jwt_secret
BILLING_JWT_ISSUER=billing-admin
BILLING_JWT_AUDIENCE=billing-api
BILLING_API_KEY_PEPPER_FILE=/run/secrets/api_key_pepper
BILLING_API_KEY_REPLAY_KEY_FILE=/run/secrets/api_key_replay_key
BILLING_API_KEY_REPLAY_TTL_SECONDS=300
# En cada receptor, BILLING_MASTER_KEY_FILE apunta sólo a su master key propia.
BILLING_MASTER_KEY_FILE=/run/secrets/sunat_master_key
SUNAT_INTERNAL_SERVICE_SECRET_FILE=/run/secrets/sunat_internal_secret
WEBHOOK_INTERNAL_SERVICE_SECRET_FILE=/run/secrets/webhook_internal_secret

R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=billing-private
R2_ACCESS_KEY_ID_FILE=/run/secrets/r2_access_key_id
R2_SECRET_ACCESS_KEY_FILE=/run/secrets/r2_secret_access_key
R2_SIGNED_URL_TTL_SECONDS=300

ALLOW_VOLATILE_ADAPTERS=false
SUNAT_PROVIDER_MODE=mock
SUNAT_ENVIRONMENT=production
SUNAT_MOCK_ALLOW_ANY_ISSUER=false
# SUNAT_MOCK_ISSUER_IDS=uuid-1,uuid-2
# SUNAT_BILL_SERVICE_URL=https://host-oficial-sunat/ruta
# SUNAT_CONSULT_SERVICE_URL=https://host-oficial-sunat/ruta
SUNAT_TIMEOUT_MS=30000
WEBHOOK_TIMEOUT_MS=10000
